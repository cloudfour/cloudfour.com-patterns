{
  "name": "@cloudfour/patterns",
  "version": "17.1.0",
  "author": "Cloud Four",
  "description": "Front-end patterns for cloudfour.com",
  "homepage": "https://github.com/cloudfour/cloudfour.com-patterns",
  "license": "MIT",
  "keywords": [
    "pattern",
    "styleguide",
    "component",
    "framework",
    "boilerplate",
    "html",
    "ui",
    "css",
    "bem",
    "typography"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudfour/cloudfour.com-patterns.git"
  },
  "main": "./dist/cloudfour-patterns.js",
  "unpkg": "./dist/cloudfour-patterns.min.js",
  "module": "./dist/cloudfour-patterns.mjs",
  "exports": {
    ".": {
      "types": "./dist/cloudfour-patterns.d.ts",
      "default": "./dist/cloudfour-patterns.mjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/assets/*": "./src/assets/*",
    "./src/compiled/tokens/*": "./src/compiled/tokens/*",
    "./src/*.scss": "./src/*.scss",
    "./src/*.twig": "./src/*.twig"
  },
  "types": "./dist/cloudfour-patterns.d.ts",
  "files": [
    "/dist",
    "/src/compiled/tokens",
    "/src/**/*.scss",
    "/src/**/*.twig",
    "!/src/**/demo/**/*.twig",
    "/src/assets",
    "!.gitignore",
    "!src/index.scss",
    "!src/index-with-dependencies.scss"
  ],
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@cloudfour/eslint-config": "25.0.1",
    "@etchteam/storybook-addon-status": "8.1.0",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/html": "10.5.10",
    "@storybook/html-vite": "10.5.10",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@types/lodash": "4.17.25",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@whitespace/storybook-addon-html": "9.0.0",
    "@wordpress/block-library": "10.4.0",
    "browserify-transform-tools": "1.7.0",
    "cssnano": "8.0.7",
    "eliminate": "1.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-react": "7.37.5",
    "highlight.js": "11.12.0",
    "jabber": "1.5.3",
    "js-yaml": "5.3.0",
    "jsdom": "30.0.1",
    "lodash": "4.18.1",
    "ltx": "3.1.2",
    "npm-run-all2": "9.0.3",
    "playwright": "1.62.1",
    "postcss": "8.5.26",
    "postcss-inline-svg": "6.0.0",
    "postcss-media-minmax": "5.0.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-syntax-highlighter": "16.1.1",
    "remark-preset-lint-recommended": "7.0.1",
    "remark-preset-prettier": "2.0.2",
    "resolve": "1.22.12",
    "rollup": "4.62.5",
    "rollup-plugin-dts": "6.5.1",
    "sass": "1.103.1",
    "storybook": "10.5.10",
    "style-dictionary": "5.5.2",
    "stylelint": "16.26.1",
    "stylelint-config-cloudfour": "10.0.0",
    "stylelint-scss": "7.2.0",
    "stylelint-use-logical-spec": "5.0.1",
    "svgo": "4.0.2",
    "twing": "7.3.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.11"
  },
  "scripts": {
    "start": "npm run storybook",
    "storybook": "npm run preprocess && run-p watch start-storybook",
    "start-storybook": "storybook dev -p 6006",
    "build-storybook": "npm run preprocess && storybook build",
    "preprocess": "run-p preprocess:*",
    "preprocess:svg-to-twig": "node scripts/build-svg-twig.mjs",
    "preprocess:tokens": "node .style-dictionary/build.mjs",
    "watch": "run-p watch:*",
    "watch:preprocess": "node scripts/watch-preprocess.mjs",
    "build": "run-s clean preprocess && run-p build:*",
    "build:types": "npm run type && node scripts/build-types.mjs",
    "build:js": "node scripts/build-js.mjs",
    "build:sass": "node scripts/build-sass.mjs",
    "clean": "run-s clean:*",
    "clean:dist": "eliminate dist",
    "clean:ts-dist": "eliminate ts-dist",
    "type": "tsc",
    "type:watch": "tsc --watch",
    "lint": "run-s lint:js lint:css lint:prettier",
    "lint:check": "run-s lint:*:check",
    "lint:js": "eslint . --fix",
    "lint:js:check": "eslint .",
    "lint:css": "stylelint --fix '**/*.scss'",
    "lint:css:check": "stylelint '**/*.scss'",
    "lint:prettier": "prettier . --write",
    "lint:prettier:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "run-s build test lint:check type",
    "version": "changeset version && prettier --write .",
    "release": "npm run build && changeset publish"
  }
}
