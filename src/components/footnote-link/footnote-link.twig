{# Twig 3 (and so Twing 7) removed the `spaceless` tag in favour of the filter. #}
{% apply spaceless %}
<a
  class="c-footnote-link"
  href="#footnote-{{id|default(count)}}"
  id="footnote-anchor-{{id|default(count)}}"
>
  <span class="u-hidden-visually">Footnote</span>
  {{count}}
</a>
{% endapply %}
